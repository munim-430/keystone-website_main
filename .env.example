# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL where the app is hosted.
APP_URL="MY_APP_URL"

# Keystone website backend (Supabase)
# Server-only. NEVER expose the service role key through a VITE_ variable.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Browser-safe values used only for the authenticated staff dashboard.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"

# Public site uses same-origin API routes by default.
VITE_LEAD_API_URL="/api/lead"

# Set after the company brochure is uploaded to the public company-assets bucket.
VITE_COMPANY_PROFILE_URL="https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/company-assets/keystone-overseas-company-profile.pdf"
