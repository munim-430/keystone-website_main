{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "keystoneeducations.com"
        }
      ],
      "destination": "https://www.keystoneeducations.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/districts", "destination": "https://keystone-seo-engine.vercel.app/" },
    { "source": "/districts/", "destination": "https://keystone-seo-engine.vercel.app/" },
    { "source": "/districts/:path*", "destination": "https://keystone-seo-engine.vercel.app/districts/:path*" },
    { "source": "/cyprus-without-ielts/:path*", "destination": "https://keystone-seo-engine.vercel.app/cyprus-without-ielts/:path*" },
    { "source": "/romania-prep-year/:path*", "destination": "https://keystone-seo-engine.vercel.app/romania-prep-year/:path*" },
    { "source": "/malaysia-fast-eval/:path*", "destination": "https://keystone-seo-engine.vercel.app/malaysia-fast-eval/:path*" },
    { "source": "/hungary-schengen/:path*", "destination": "https://keystone-seo-engine.vercel.app/hungary-schengen/:path*" },
    { "source": "/south-korea-scholarship/:path*", "destination": "https://keystone-seo-engine.vercel.app/south-korea-scholarship/:path*" },
    { "source": "/ielts-dhanmondi-academy/:path*", "destination": "https://keystone-seo-engine.vercel.app/ielts-dhanmondi-academy/:path*" },
    { "source": "/compare", "destination": "https://keystone-seo-engine.vercel.app/compare/" },
    { "source": "/compare/", "destination": "https://keystone-seo-engine.vercel.app/compare/" },
    { "source": "/compare/:path*", "destination": "https://keystone-seo-engine.vercel.app/compare/:path*" },
    { "source": "/sitemap-districts.xml", "destination": "https://keystone-seo-engine.vercel.app/sitemap-index.xml" },
    { "source": "/sitemap-0.xml", "destination": "https://keystone-seo-engine.vercel.app/sitemap-0.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
